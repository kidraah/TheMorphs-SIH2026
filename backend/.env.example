# VARUNA Environment Configuration
# Copy this file to .env and adjust as necessary

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Model Configuration
MODEL_REPO_ID=JayF14/varuna-HybridTransU-net
MODEL_FILENAME=best_model.pth
USE_GPU=true

# Frontend
FRONTEND_URL=http://localhost:3000

# Thresholds
ALERT_THRESHOLD_WATCH=0.3
ALERT_THRESHOLD_WARNING=0.5
ALERT_THRESHOLD_EMERGENCY=0.7
