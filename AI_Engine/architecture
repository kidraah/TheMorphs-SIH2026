## Full Forward Pass: Everything Together

```python
# model.py: forward() — Complete data flow

def forward(self, imdaa, insat, terrain):
    # imdaa:   (B, 30, 6, 256, 256)
    # insat:   (B,  4, 6, 256, 256)
    # terrain: (B,  2,    256, 256)

    # ── STAGE 1: Temporal Compression ─────────────────────────────────────
    x_imdaa   = self.imdaa_time_compress(imdaa).squeeze(2)   # (B, 64, 256, 256)
    x_insat   = self.insat_time_compress(insat).squeeze(2)    # (B, 32, 256, 256)
    x_terrain = self.terrain_embed(terrain)                    # (B, 16, 256, 256)

    # ── STAGE 2: Early Fusion ─────────────────────────────────────────────
    x = torch.cat([x_imdaa, x_insat, x_terrain], dim=1)       # (B, 112, 256, 256)

    # ── STAGE 3: Shared Encoder (save skip connections!) ──────────────────
    e1     = self.enc1(x)        # (B, 128, 256, 256)  ← skip connection saved
    e2     = self.enc2(self.pool1(e1))  # (B, 256, 128, 128)  ← skip connection saved
    x_pool2 = self.pool2(e2)     # (B, 256, 64, 64)

    # ── STAGE 4: Hybrid Bottleneck ────────────────────────────────────────
    b = self.bottleneck(x_pool2) # (B, 512, 64, 64)  ← CNN compress
    b = self.attention(b)        # (B, 512, 64, 64)  ← Transformer global context

    # ── STAGE 5: Multi-Task Decoders ──────────────────────────────────────
    # All three heads receive the SAME 'b' as input
    # (but have INDEPENDENT weights → they specialize differently)
    ts_pred = self._decode_ts(b, e1, e2)   # (B, 1, 256, 256) Thunderstorm
    cb_pred = self._decode_cb(b, e1, e2)   # (B, 1, 256, 256) Cloudburst
    ff_pred = self._decode_ff(b, e1, e2)   # (B, 1, 256, 256) Flash Flood

    # Stack and return: [Cloudburst, Thunderstorm, FlashFlood]
    return torch.cat([cb_pred, ts_pred, ff_pred], dim=1)  # (B, 3, 256, 256)
```

