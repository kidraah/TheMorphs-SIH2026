# Copy to .env (gitignored) and fill in. Never commit .env.
#
#   cp .env.example .env
#
# MOSDAC -- INSAT-3D/3DR L1B imagery.  https://mosdac.gov.in
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# NASA Earthdata Login -- GPM IMERG via GES DISC.  https://urs.earthdata.nasa.gov
# GES DISC also needs the application authorised once in your Earthdata profile:
# Applications -> Authorized Apps -> "NASA GESDISC DATA ARCHIVE".
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional -- IMDAA reanalysis. Deferred: ERA5 covers the thermodynamics and
# does not need the NCMRWF transfer.
NCMRWF_USERNAME=
NCMRWF_PASSWORD=

# Optional -- Copernicus CDS for ERA5.  https://cds.climate.copernicus.eu
CDSAPI_KEY=
